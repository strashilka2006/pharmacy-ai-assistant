# Что НЕ копировать в образ.
# Без этого файла COPY . . утащит внутрь мусор и раздует образ,
# а главное — может занести твой настоящий config.php с паролями.

.git
.gitignore
vendor/          # ставится внутри образа через composer install
app/config.php   # реальные ключи не должны попасть в образ
*.md
.idea/
.vscode/
